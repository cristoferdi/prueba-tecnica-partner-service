# Spring Boot / PostgreSQL configuration
# Copy this file to .env and adjust values as needed.
# Default values below are functional out of the box (local PostgreSQL on 5432).

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=telco_db

# Optional: use a full JDBC URL instead of the individual fields above.
# DB_URL=jdbc:postgresql://localhost:5432/telco_db

# JWT configuration (for development only)
# IMPORTANT: Use a strong secret in production via environment variable.
JWT_SECRET=dev-secret-key-for-local-development-only-change-in-production-2025
JWT_EXPIRATION=3600000
