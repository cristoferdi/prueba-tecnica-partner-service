# Spring Boot / PostgreSQL configuration
# Copy this file to .env and adjust values as needed

# Database connection
DB_URL=jdbc:postgresql://localhost:5432/telco_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=telco_db
DB_PORT=5432

# JWT configuration (for development only)
# IMPORTANT: Use a strong secret in production via environment variable
JWT_SECRET=dev-secret-key-for-local-development-only-change-in-production-2025
JWT_EXPIRATION=3600000
